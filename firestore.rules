rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() { return request.auth.token.email; }
    function uid() { return request.auth.uid; }
    function member(trip) {
      return verified() && (email() in trip.memberEmails || uid() in trip.get('memberUids', []));
    }
    function admin(trip) {
      return verified() && uid() == trip.ownerUid;
    }
    match /trips/{tripId} {
      function invitation() {
        return get(/databases/$(database)/documents/trips/$(tripId)/invites/$(request.auth.token.email.lower())).data;
      }
      function claim() {
        let old = resource.data.get('memberUids', []);
        let invite = invitation();
        return verified() && !(uid() in old) && invite.acceptedUid == ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids == old.concat([uid()])
          && request.resource.data.memberUids.size() <= 20
          && getAfter(/databases/$(database)/documents/trips/$(tripId)/invites/$(request.auth.token.email.lower())).data.acceptedUid == uid();
      }
      allow get: if member(resource.data) || admin(resource.data);
      allow list: if request.query.limit <= 50 && member(resource.data);
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['name','ownerUid','memberEmails','memberUids','createdAt','crewRemovalTracked'])
        && request.resource.data.get('crewRemovalTracked', true) == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.ownerUid == uid()
        && request.resource.data.memberEmails == []
        && request.resource.data.memberUids == [uid()]
        && request.resource.data.createdAt == request.time;
      function removing(before, after, target) {
        return before.get('crewRemovalTracked', false) == true
          && before.get('status', 'active') == 'active' && !before.get('closed', false)
          && before.memberEmails == [] && target != before.ownerUid
          && after.diff(before).affectedKeys().hasOnly(['memberUids'])
          && target in before.memberUids
          && after.memberUids == before.memberUids.removeAll([target])
          && !existsAfter(/databases/$(database)/documents/trips/$(tripId)/finance/firstExpense);
      }
      function removeJoined() {
        let removed = resource.data.memberUids.removeAll(request.resource.data.memberUids);
        return admin(resource.data) && removed.size() == 1 && removing(resource.data, request.resource.data, removed[0]);
      }
      allow update: if claim() || removeJoined();
      match /finance/firstExpense {
        allow create: if admin(parentTrip()) && parentTrip().get('crewRemovalTracked', false) == true
          && request.resource.data.keys().hasOnly(['expenseId'])
          && request.resource.data.expenseId is string
          && !exists(/databases/$(database)/documents/trips/$(tripId)/expenses/$(request.resource.data.expenseId))
          && existsAfter(/databases/$(database)/documents/trips/$(tripId)/expenses/$(request.resource.data.expenseId));
        allow get: if admin(parentTrip());
      }
      match /invites/{address} {
        function trip() { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
        allow get: if admin(trip()) || (verified() && (email().lower() == address || resource.data.acceptedUid == uid()));
        allow list: if admin(trip()) && request.query.limit <= 50;
        allow create: if admin(trip()) && request.resource.data.keys().hasAll(['name','mobile','acceptedUid'])
          && request.resource.data.keys().hasOnly(['name','mobile','acceptedUid'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.mobile is string && request.resource.data.mobile.size() >= 7 && request.resource.data.mobile.size() <= 22
          && request.resource.data.acceptedUid == ''
          && !(address in trip().memberEmails);
        function pendingAdmin() {
          return admin(trip()) && resource.data.acceptedUid == ''
            && trip().get('status', 'active') == 'active' && trip().get('closed', false) == false;
        }
        allow delete: if pendingAdmin();
        allow update: if pendingAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','mobile'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.mobile is string && request.resource.data.mobile.size() >= 7 && request.resource.data.mobile.size() <= 22;
        allow update: if verified() && email().lower() == address && resource.data.acceptedUid == ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedUid'])
          && request.resource.data.acceptedUid == uid()
          && uid() in getAfter(/databases/$(database)/documents/trips/$(tripId)).data.get('memberUids', []);
      }
      function parentTrip() { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
      function crew() { return member(parentTrip()) || admin(parentTrip()); }
      function activeTrip() {
        return parentTrip().get('status', '') != 'closed' && parentTrip().get('closed', false) != true;
      }
      match /profiles/{userId} {
        allow get: if crew();
        allow list: if crew() && request.query.limit <= 100;
        allow create, update: if crew() && activeTrip() && userId == uid()
          && request.resource.data.keys().hasOnly(['name','updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.updatedAt == request.time;
      }
      match /packing/{itemId} {
        allow get: if crew();
        allow list: if crew() && request.query.limit <= 100;
        allow create: if crew() && activeTrip()
          && request.resource.data.keys().hasOnly(['item','assignee','checked','checkedBy','createdAt'])
          && request.resource.data.item is string
          && request.resource.data.item.size() > 0 && request.resource.data.item.size() <= 100
          && request.resource.data.assignee is string
          && (request.resource.data.assignee == '' || request.resource.data.assignee == parentTrip().ownerUid
            || request.resource.data.assignee == uid() || request.resource.data.assignee in parentTrip().get('memberUids', []))
          && request.resource.data.checked == false && request.resource.data.checkedBy == ''
          && request.resource.data.createdAt == request.time;
        allow update: if crew() && activeTrip()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checked','checkedBy'])
          && request.resource.data.checked is bool
          && request.resource.data.checkedBy == (request.resource.data.checked ? uid() : '');
      }
      match /plans/{planId} {
        allow get: if crew();
        allow list: if crew() && request.query.limit <= 100;
        allow create: if admin(parentTrip()) && activeTrip()
          && request.resource.data.keys().hasOnly(['title','startsAt','createdAt'])
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
          && request.resource.data.startsAt is timestamp && request.resource.data.createdAt == request.time;
      }
      match /messages/{messageId} {
        allow get: if crew();
        allow list: if crew() && request.query.limit <= 100;
        allow create: if crew() && activeTrip()
          && request.resource.data.keys().hasOnly(['text','authorUid','createdAt'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.authorUid == uid() && request.resource.data.createdAt == request.time;
      }
      match /presence/{userId} {
        function validPosition(p) {
          return p.keys().hasOnly(['lat','lng','accuracy','heading','speed','label','active','updatedAt'])
            && p.lat is number && p.lat >= -90 && p.lat <= 90
            && p.lng is number && p.lng >= -180 && p.lng <= 180
            && p.accuracy is number && p.accuracy >= 0 && p.accuracy <= 10000
            && (p.heading == null || (p.heading is number && p.heading >= 0 && p.heading <= 360))
            && (p.speed == null || (p.speed is number && p.speed >= 0 && p.speed <= 200))
            && p.label is string && p.label.size() > 0 && p.label.size() <= 80
            && p.active == true && p.updatedAt == request.time;
        }
        allow get: if crew();
        allow list: if crew() && request.query.limit <= 100;
        allow create: if crew() && activeTrip() && userId == uid() && validPosition(request.resource.data);
        allow update: if crew() && activeTrip() && userId == uid() && validPosition(request.resource.data)
          && request.time >= resource.data.updatedAt + duration.value(15, 's');
        allow delete: if verified() && userId == uid();
      }
      match /map/meeting {
        function trip() { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
        allow get: if member(trip()) || admin(trip());
        allow create, update: if admin(trip())
          && request.resource.data.keys().hasOnly(['name','lat','lng','updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
          && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
          && request.resource.data.updatedAt == request.time;
        allow delete: if admin(trip());
      }
      match /expenses/{expenseId} {
        function trip() { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
        allow get: if member(trip()) || admin(trip());
        allow list: if request.query.limit <= 100 && (member(trip()) || admin(trip()));
        allow create: if admin(trip())
          && request.resource.data.keys().hasAll(['label','paise','payer','participants','createdAt'])
          && request.resource.data.keys().hasOnly(['label','paise','payer','participants','createdAt'])
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 80
          && request.resource.data.paise is int && request.resource.data.paise > 0 && request.resource.data.paise <= 100000000
          && request.resource.data.participants == getAfter(/databases/$(database)/documents/trips/$(tripId)).data.memberEmails.concat(getAfter(/databases/$(database)/documents/trips/$(tripId)).data.get('memberUids', []))
          && (!trip().get('crewRemovalTracked', false) || existsAfter(/databases/$(database)/documents/trips/$(tripId)/finance/firstExpense))
          && request.resource.data.payer in request.resource.data.participants
          && request.resource.data.createdAt == request.time;
      }
    }
  }
}
